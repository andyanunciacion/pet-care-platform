# Dependencies
node_modules/

# Build output and caches
dist/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo
# Regenerated by Next.js on every dev/build/typegen
next-env.d.ts

# Env files (secrets). Only the example is committed.
.env
.env.*
!.env.example

# Logs
*.log

# Downloaded source data (e.g. the PSA's PSGC .xlsx, re-downloadable; see packages/db/scripts/psgc-sql.ts)
*.xlsx

# OS / editor
.DS_Store
Thumbs.db
.idea/

# Hosting CLIs
.vercel/

# Claude Code personal settings
.claude/settings.local.json

# impeccable-ignore-start
# Impeccable design plugin: commit .impeccable/design.json, apps/web/.impeccable/live/config.json
# (and config.json once a setting is shared); per-developer settings and the hook cache stay
# local. Its runtime folders (questions/, mocks/, review/, critique snapshots) ignore
# themselves; live mode keeps its own block in apps/web/.gitignore, written by the tool.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
# impeccable-ignore-end

# Lighthouse CI: generated fixture images and run reports (ARCHITECTURE D44)
packages/lighthouse/.images/
.lighthouseci/
