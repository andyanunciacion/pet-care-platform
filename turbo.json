{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  // Passed to every task without changing cache keys. NODE_EXTRA_CA_CERTS: antivirus or
  // company proxies that re-sign HTTPS (e.g. Avast's Web Shield) add their root here, or
  // the API can't reach Cloudflare R2 ("unable to verify the first certificate").
  "globalPassThroughEnv": ["NODE_EXTRA_CA_CERTS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Turbo hides env vars not listed here from tasks ("strict" mode). The web build
      // reads API_URL for the /v1 rewrite, PHOTOS_URL for next/image's allowed host and
      // SITE_URL for absolute metadata URLs; they're part of the cache key: another URL
      // means another build.
      "env": ["API_URL", "PHOTOS_URL", "SITE_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      // The web typecheck runs `next typegen`, which loads next.config.ts (rewrites, images).
      "env": ["API_URL", "PHOTOS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
