{
  "name": "@paw/api",
  "version": "0.0.0",
  "private": true,
  "description": "PAW REST API (Fastify).",
  "type": "module",
  "exports": {
    "./openapi": "./src/openapi.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts",
    "promote-admin": "node --env-file-if-exists=.env scripts/promote-admin.ts",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@paw/db": "workspace:*",
    "@paw/domain": "workspace:*",
    "better-auth": "catalog:",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "catalog:",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@paw/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
