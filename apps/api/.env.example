# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# Real secrets live only in the hosting platforms' secret stores.
# Every variable is validated at startup in src/env.ts; the API refuses to boot if one is invalid.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres + PostGIS from the root docker-compose.yml
DATABASE_URL=postgres://paw:paw@localhost:5432/paw

# Comma-separated browser origins allowed to call the API (the web app)
CORS_ORIGINS=http://localhost:3000

# Proxies in front of the API that append to X-Forwarded-For (0 locally; see src/env.ts)
TRUST_PROXY_HOPS=0

# --- Auth (Better Auth, ARCHITECTURE §7) ---
# Signs session cookies. Generate one: `openssl rand -base64 32` (or any 32+ random characters)
BETTER_AUTH_SECRET=
# The WEB app's origin: browsers reach /v1/auth/* through its /v1 rewrite (ARCHITECTURE D31)
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Photo storage (Cloudflare R2, ARCHITECTURE D38) ---
# Optional: left empty, the API runs and the photo routes answer 503. Set all five or none.
# Use the dev bucket here (setup steps in AI_DOCS/github-issues.md, P1-2d).
# Cloudflare dashboard → R2 → overview page (Account ID)
R2_ACCOUNT_ID=
# R2 → Manage API tokens → an Account API token with Object Read & Write on the dev bucket only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# e.g. paw-photos-dev
R2_BUCKET=
# The bucket's Public Development URL (Settings → r2.dev), e.g. https://pub-….r2.dev
R2_PUBLIC_URL=
