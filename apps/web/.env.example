# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# Server-side only. A variable is exposed to the browser only if it starts with NEXT_PUBLIC_.

# The API (apps/api). Server Components call it directly; browsers reach it through the
# /v1/* rewrite in next.config.ts (ARCHITECTURE D31), which reads it at build time too.
API_URL=http://localhost:4000

# This site's public origin, no trailing slash. Canonical URLs, Open Graph tags and JSON-LD
# start with it (ARCHITECTURE §8). Read at build time too.
SITE_URL=http://localhost:3000

# Optional: where the photo bucket's files are public, the same value as the API's
# R2_PUBLIC_URL (e.g. https://pub-….r2.dev). Public pages only show images under it
# (next.config.ts allows this host for next/image at build time; ARCHITECTURE D43).
PHOTOS_URL=
